# 默认不做任何行尾/编码转换 —— 保护二进制（.deb/.apk/ELF/.dat 等）不被剥字节
* -text

# 明确的文本类型：LF 行尾
*.md       text eol=lf
*.txt      text eol=lf
*.go       text eol=lf
*.sh       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.service  text eol=lf
*.dae      text eol=lf
*.conf     text eol=lf
