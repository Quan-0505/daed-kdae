+// ScheduledUpdate reloads only after UpdateById has committed its transaction.
+func ScheduledUpdate(ctx context.Context, id uint) (*db.Subscription, error) {
+	sub, err := UpdateById(ctx, id)
+	if err == nil {
+		maintenance.SubscriptionUpdated()
+	}
+	return sub, err
+}
