+	// kdae probes asynchronously: activate background checks, trigger a
+	// check cycle, and poll the last probe observation for a bounded window.
+	tcpV4 := &dialer.NetworkType{
+		L4Proto:   consts.L4ProtoStr_TCP,
+		IpVersion: consts.IpVersionStr_4,
+	}
+	d.ActivateCheck()
+	d.NotifyCheck()
+	var observation dialer.DialerProbeObservationSnapshot
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		observation = d.SnapshotLastProbe(tcpV4)
+		if !observation.CheckedAt.IsZero() || time.Now().After(deadline) {
+			break
+		}
+		time.Sleep(200 * time.Millisecond)
