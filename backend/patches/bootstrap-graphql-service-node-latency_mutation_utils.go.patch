+	if !observation.CheckedAt.IsZero() {
+		resolver.TestedAtV = observation.CheckedAt
+	}
+	if observation.HasLatency {
+		latencyMs := int32(observation.Latency.Milliseconds())
 		resolver.LatencyMsV = &latencyMs
-		return resolver
